/*
 * Configuration for the course RNA-seq pipeline.
 *
 * Pick a profile with -profile:
 *   slurm  the course setup on the HPC: Slurm jobs, Singularity/Apptainer
 *   test   small local run (used by CI): local executor, low resources
 *
 * The containers are set per process in main.nf. They are Singularity
 * images from Seqera Containers (oras://), which Apptainer and
 * Singularity pull directly. Docker is not used.
 */

params {
    // Slurm compute allocation (project account), e.g. --account hpc2nXXXX-YYY
    account = null
}

// Apptainer installations also provide the `singularity` command,
// so the same setting works with both.
singularity {
    enabled    = true
    autoMounts = true
    // Keep downloaded images in one place, so they are reused across runs
    cacheDir   = "${projectDir}/singularity_cache"
}

profiles {

    slurm {
        // Reuse finished tasks automatically; no need to pass -resume
        resume = true

        process {
            executor = 'slurm'
            time     = 2.h   // default for all processes
            cpus     = 4

            // Per-process resources. On our cluster memory is allocated per
            // CPU, so we do not request it separately. On other clusters you
            // may need to add e.g. memory = 4.GB.
            withName: 'INDEX' {
                time = 15.m
                cpus = 2
            }
            withName: 'QUANTIFICATION' {
                time = 30.m
                cpus = 4
            }
            withName: 'FASTQC' {
                time = 15.m
                cpus = 2
            }
            withName: 'MULTIQC' {
                time = 15.m
                cpus = 1
            }
        }

        executor {
            account = params.account
        }
    }

    test {
        process {
            executor = 'local'
            cpus     = 1
            memory   = 2.GB
            time     = 20.m
        }

        executor {
            cpus   = 2
            memory = 6.GB
        }
    }
}
